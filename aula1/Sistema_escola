

import tkinter as tk



def calcular_media():
    nota_1 = float(nota1.get())
    nota_2 = float(nota2.get())
    nota_3 = float(nota3.get())
    media = (nota_1 + nota_2 + nota_3)/3
    resultado.config(text = media)

    nome_ = nome.get()



    if media >= 7:
        situacao.config(texte = f'O Aluno (a) {nome_} PASSOU DIRETO')
    elif media >= 5 and media <7:
        situacao.config(text = f'O Aluno (a) {nome_} ESTA EM RECUPERAÇÃO')
    else:
        situacao.config(text = f'O Aluno (a) {nome_} NÃO PASSOU...')     
     

janela = tk.Tk()
janela.geometry('400x400')

titulo = tk.Label(janela, text = 'SISTEMA ESCOLA CAVALCANTI')
titulo.pack()

nome_titulo = tk.Label(janela, text = 'Nome:')
nome_titulo.pack()


nome = tk.Entry(janela)
nome.pack(pady = 5)

tk.Label(janela, text= 'Nota 1'). pack()
nota1 = tk.Entry(janela, text = "Nota 1")
nota1.pack(pady = 5)

tk.Label(janela, text= 'Nota 2'). pack()
nota2 = tk.Entry(janela, text = "Nota 2")
nota2.pack(pady = 5)

tk.Label(janela, text= 'Nota 3'). pack()
nota3 = tk.Entry(janela, text = "Nota 3")
nota3.pack(pady = 5)

botao = tk.Button(janela, text = 'calcular', command = calcular_media)
botao.pack()

resultado = tk.Label(janela, text = '')
resultado.pack()

tk.Label(janela, text= 'Situação'). pack()
situacao = tk.Label(janela, text =  '')
situacao.pack()

janela.mainloop()
